// Subset of the Log Analytics / Sentinel schema used by the detections.
// Prepended to every query by check.js so the Kusto analyzer can resolve
// tables, columns and types. Extend this when a rule uses a new column.
// Column names/types follow the Azure Monitor table reference.
let AzureActivity = datatable(
    TimeGenerated:datetime, OperationNameValue:string, OperationName:string,
    ActivityStatusValue:string, ActivitySubstatusValue:string, CategoryValue:string,
    Caller:string, CallerIpAddress:string, CorrelationId:string, Properties_d:dynamic,
    Authorization_d:dynamic, Claims_d:dynamic, ResourceGroup:string, SubscriptionId:string,
    ResourceProviderValue:string, _ResourceId:string, Level:string)[];
let AzureDiagnostics = datatable(
    TimeGenerated:datetime, ResourceProvider:string, ResourceType:string, Category:string,
    OperationName:string, Resource:string, ResourceGroup:string, ResultType:string,
    ResultSignature:string, CallerIPAddress:string, _ResourceId:string)[];
let StorageBlobLogs = datatable(
    TimeGenerated:datetime, AccountName:string, OperationName:string, Uri:string,
    CallerIpAddress:string, AuthenticationType:string, RequesterUpn:string,
    RequesterObjectId:string, RequesterAppId:string, RequesterTenantId:string,
    StatusCode:string, StatusText:string, UserAgentHeader:string, ObjectKey:string,
    _ResourceId:string)[];
let SecurityEvent = datatable(
    TimeGenerated:datetime, Computer:string, EventID:int, Activity:string, Account:string,
    AccountType:string, TargetUserName:string, TargetDomainName:string, TargetSid:string,
    SubjectUserName:string, SubjectDomainName:string, SubjectUserSid:string,
    IpAddress:string, LogonType:int, LogonProcessName:string, AuthenticationPackageName:string,
    Status:string, SubStatus:string, MemberName:string, MemberSid:string,
    NewProcessName:string, CommandLine:string, ParentProcessName:string, EventData:string,
    _ResourceId:string)[];
let Syslog = datatable(
    TimeGenerated:datetime, Computer:string, HostIP:string, HostName:string, Facility:string,
    SeverityLevel:string, ProcessName:string, ProcessID:int, SyslogMessage:string,
    _ResourceId:string)[];
let SigninLogs = datatable(
    TimeGenerated:datetime, UserPrincipalName:string, UserId:string, UserDisplayName:string,
    IPAddress:string, Location:string, LocationDetails:dynamic, ResultType:string,
    ResultDescription:string, AppDisplayName:string, AppId:string, ClientAppUsed:string,
    UserAgent:string, ConditionalAccessStatus:string, AuthenticationRequirement:string,
    RiskLevelDuringSignIn:string, RiskLevelAggregated:string, RiskState:string,
    RiskDetail:string, RiskEventTypes_V2:string, CorrelationId:string, Category:string)[];
let AADNonInteractiveUserSignInLogs = datatable(
    TimeGenerated:datetime, UserPrincipalName:string, UserId:string, UserDisplayName:string,
    IPAddress:string, Location:string, LocationDetails:string, ResultType:string,
    ResultDescription:string, AppDisplayName:string, AppId:string, ClientAppUsed:string,
    UserAgent:string, ConditionalAccessStatus:string, AuthenticationRequirement:string,
    RiskLevelDuringSignIn:string, RiskLevelAggregated:string, RiskState:string,
    RiskDetail:string, RiskEventTypes_V2:string, CorrelationId:string, Category:string)[];
let AuditLogs = datatable(
    TimeGenerated:datetime, OperationName:string, ActivityDisplayName:string, Category:string,
    Result:string, ResultReason:string, LoggedByService:string, InitiatedBy:dynamic,
    TargetResources:dynamic, AdditionalDetails:dynamic, CorrelationId:string, Id:string)[];
let AADUserRiskEvents = datatable(
    TimeGenerated:datetime, UserPrincipalName:string, UserId:string, UserDisplayName:string,
    IpAddress:string, Location:dynamic, RiskLevel:string, RiskEventType:string, RiskState:string,
    RiskDetail:string, DetectionTimingType:string, Source:string, Id:string)[];
let _GetWatchlist = (watchlistAlias:string) { datatable(SearchKey:string, Caller:string, Reason:string, UserPrincipalName:string, ObjectId:string, Purpose:string)[] };

// Traffic Analytics enriched flow records (VNet flow logs). Subset of the
// documented NTANetAnalytics columns used by the NET-* detections.
let NTANetAnalytics = datatable(
    TimeGenerated:datetime, SubType:string, FaSchemaVersion:string, Type:string,
    FlowType:string, FlowDirection:string, FlowStatus:string, L4Protocol:string, L7Protocol:string,
    SrcIp:string, DestIp:string, DestPort:int, SrcPorts:string,
    SrcVm:string, DestVm:string, SrcNic:string, DestNic:string, SrcSubnet:string, DestSubnet:string,
    SrcRegion:string, DestRegion:string, SrcSubscription:string, DestSubscription:string,
    SrcPublicIps:string, DestPublicIps:string, Country:string, AzureRegion:string,
    AllowedInFlows:long, AllowedOutFlows:long, DeniedInFlows:long, DeniedOutFlows:long,
    BytesSrcToDest:long, BytesDestToSrc:long, PacketsSrcToDest:long, PacketsDestToSrc:long,
    CompletedFlows:long, RecordCount:long, FlowStartTime:datetime, FlowEndTime:datetime,
    FlowIntervalStartTime:datetime, FlowIntervalEndTime:datetime,
    AclGroup:string, AclRule:string, NsgList:string, NsgRule:string,
    TargetResourceId:string, TargetResourceType:string, FlowLogResourceId:string, LogResourceId:string)[];
