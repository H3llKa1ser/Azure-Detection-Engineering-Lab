# Copy to terraform.tfvars and fill in.
subscription_id = "00000000-0000-0000-0000-000000000000"

location = "westeurope"
prefix   = "detlab"

# Leave unset to auto-detect via api.ipify.org
# operator_ip = "203.0.113.10"

# Extra IPs allowed through the Key Vault / Storage firewalls (bare IPv4).
# CI sets this from the OPERATOR_ALLOWED_IPS repo variable.
additional_allowed_ips = []

deploy_windows_vm = true
deploy_linux_vm   = true

auto_shutdown_time     = "1900"
auto_shutdown_timezone = "W. Europe Standard Time"

daily_quota_gb = 1

# Identity layer - needs Entra ID P1 (P2 for risk detections) and tenant admin
# rights. Use a dev/test tenant. See docs/entra-id.md.
enable_entra_id = false
entra_id_p2     = false

# Network layer - VNet flow logs + Traffic Analytics (adds ingestion cost and
# 10-60 min processing latency). See docs/network-detections.md.
enable_flow_logs          = false
flow_log_interval_minutes = 10

# Sysmon on the Windows victim (needs deploy_windows_vm = true). Adds Event-table
# ingestion. Empty sysmon_config_url uses the compact built-in config.
enable_sysmon     = false
sysmon_config_url = ""

# SOAR: auto-disable the principal on KV-001 / STG-001. Dry-run by default (only
# comments). Enforcing needs playbook_dry_run=false + playbook_grant_graph=true
# and tenant admin at apply time. See docs/response-playbook.md.
enable_response_playbook = false
playbook_dry_run         = true
playbook_auto_run        = true
playbook_grant_graph     = false

# Break-glass accounts / CI service principals. Do NOT add yourself.
approved_privileged_callers = []
