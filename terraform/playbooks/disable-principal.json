{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "playbookName": { "type": "string" },
    "location": { "type": "string" },
    "dryRun": {
      "type": "bool",
      "defaultValue": true,
      "metadata": { "description": "When true, the playbook only comments on the incident instead of disabling the principal." }
    },
    "tags": { "type": "object", "defaultValue": {} }
  },
  "variables": {
    "sentinelConnectionName": "[concat('azuresentinel-', parameters('playbookName'))]",
    "graphAudience": "https://graph.microsoft.com"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('sentinelConnectionName')]",
      "location": "[parameters('location')]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('sentinelConnectionName')]",
        "customParameterValues": {},
        "parameterValueType": "Alternative",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('playbookName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "identity": { "type": "SystemAssigned" },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('sentinelConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "parameters": {
          "dryRun": { "value": "[parameters('dryRun')]" },
          "$connections": {
            "value": {
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('sentinelConnectionName'))]",
                "connectionName": "[variables('sentinelConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/azuresentinel')]",
                "connectionProperties": {
                  "authentication": { "type": "ManagedServiceIdentity" }
                }
              }
            }
          }
        },
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "dryRun": { "type": "bool", "defaultValue": true },
            "$connections": { "type": "object", "defaultValue": {} }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "Initialize_actor_upn": {
              "runAfter": {},
              "type": "InitializeVariable",
              "inputs": { "variables": [ { "name": "ActorUpn", "type": "string" } ] }
            },
            "Initialize_actor_id": {
              "runAfter": { "Initialize_actor_upn": [ "Succeeded" ] },
              "type": "InitializeVariable",
              "inputs": { "variables": [ { "name": "ActorId", "type": "string" } ] }
            },
            "Initialize_summary": {
              "runAfter": { "Initialize_actor_id": [ "Succeeded" ] },
              "type": "InitializeVariable",
              "inputs": { "variables": [ { "name": "Summary", "type": "string", "value": "No Account entity found on the incident." } ] }
            },
            "For_each_account": {
              "runAfter": { "Initialize_summary": [ "Succeeded" ] },
              "type": "Foreach",
              "foreach": "@triggerBody()?['object']?['properties']?['relatedEntities']",
              "actions": {
                "If_account_entity": {
                  "type": "If",
                  "expression": {
                    "and": [
                      { "equals": [ "@toLower(item()?['kind'])", "account" ] }
                    ]
                  },
                  "actions": {
                    "Set_actor_upn": {
                      "runAfter": {},
                      "type": "SetVariable",
                      "inputs": {
                        "name": "ActorUpn",
                        "value": "@{coalesce(item()?['properties']?['additionalData']?['UserPrincipalName'], concat(item()?['properties']?['accountName'], '@', coalesce(item()?['properties']?['upnSuffix'], '')), item()?['properties']?['friendlyName'])}"
                      }
                    },
                    "Set_actor_id": {
                      "runAfter": { "Set_actor_upn": [ "Succeeded" ] },
                      "type": "SetVariable",
                      "inputs": {
                        "name": "ActorId",
                        "value": "@{coalesce(item()?['properties']?['aadUserId'], item()?['properties']?['additionalData']?['AadUserId'], '')}"
                      }
                    }
                  }
                }
              }
            },
            "Condition_dry_run": {
              "runAfter": { "For_each_account": [ "Succeeded" ] },
              "type": "If",
              "expression": {
                "and": [
                  { "equals": [ "@parameters('dryRun')", true ] }
                ]
              },
              "actions": {
                "Set_summary_dryrun": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "Summary",
                    "value": "DRY RUN: would disable principal '@{variables('ActorUpn')}' (id '@{variables('ActorId')}') after honeytoken access. No change made. Set dryRun=false to enforce."
                  }
                }
              },
              "else": {
                "actions": {
                  "Disable_user_via_Graph": {
                    "type": "Http",
                    "inputs": {
                      "method": "PATCH",
                      "uri": "https://graph.microsoft.com/v1.0/users/@{coalesce(variables('ActorId'), variables('ActorUpn'))}",
                      "headers": { "Content-Type": "application/json" },
                      "body": { "accountEnabled": false },
                      "authentication": {
                        "type": "ManagedServiceIdentity",
                        "audience": "[variables('graphAudience')]"
                      }
                    }
                  },
                  "Revoke_sessions_via_Graph": {
                    "runAfter": { "Disable_user_via_Graph": [ "Succeeded" ] },
                    "type": "Http",
                    "inputs": {
                      "method": "POST",
                      "uri": "https://graph.microsoft.com/v1.0/users/@{coalesce(variables('ActorId'), variables('ActorUpn'))}/revokeSignInSessions",
                      "authentication": {
                        "type": "ManagedServiceIdentity",
                        "audience": "[variables('graphAudience')]"
                      }
                    }
                  },
                  "Set_summary_enforced": {
                    "runAfter": { "Revoke_sessions_via_Graph": [ "Succeeded", "Failed" ] },
                    "type": "SetVariable",
                    "inputs": {
                      "name": "Summary",
                      "value": "ENFORCED: disabled principal '@{variables('ActorUpn')}' (id '@{variables('ActorId')}') and revoked its sessions after honeytoken access. Graph disable status: @{outputs('Disable_user_via_Graph')?['statusCode']}."
                    }
                  }
                }
              }
            },
            "Add_comment_to_incident": {
              "runAfter": { "Condition_dry_run": [ "Succeeded" ] },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/Incidents/Comment",
                "body": {
                  "incidentArmId": "@triggerBody()?['object']?['id']",
                  "message": "<p><b>Auto-response (disable-principal playbook)</b><br>@{variables('Summary')}</p>"
                }
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "playbookResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('playbookName'))]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('playbookName')), '2019-05-01', 'Full').identity.principalId]"
    }
  }
}
